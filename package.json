{
  "name": "noava",
  "version": "2.3.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "description": "NOAVA personal planner with unified Persian calendar and Vercel API.",
  "scripts": {
    "db:import": "node scripts/import-local-to-postgres.mjs",
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "npm run build",
    "demo": "node server/index.js",
    "preview": "node server/index.js",
    "qa": "node scripts/qa.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "npm run qa",
    "build:release": "npm run qa && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/postgres": "^6.1.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "vite": "^7.1.3"
  }
}
