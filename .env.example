# Runtime
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173

# Storage
# Leave empty only for local single-user mode (persisted in .local/memory-PORT.json).
# A staging or production environment must set a PostgreSQL connection string.
DATABASE_URL=
# Vercel's existing Prisma integration may instead supply scdule_DATABASE_URL.
# DATABASE_URL takes precedence when both are set.
# Optional local snapshot path. Set to "off" for disposable test servers.
# NOVA_LOCAL_STORE=.local/memory-3001.json

# Authentication
# Use a long, random value in staging and production. Do not commit the real value.
AUTH_SECRET=

# Optional AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
